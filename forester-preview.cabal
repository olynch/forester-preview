cabal-version: 3.4
name: forester-preview
version: 0.1.0.0
license: (Apache-2.0 OR MIT)
author: Coln contributors
maintainer: root@owenlynch.org
category: Development
build-type: Simple

common warnings
  ghc-options: -Wall

executable forester-preview
  import: warnings
  main-is: Main.hs
  build-depends:
    async,
    base,
    bytestring,
    directory,
    extra,
    fsnotify,
    process,
    servant,
    servant-event-stream,
    servant-server,
    temporary >=1.3,
    text,
    warp,

  hs-source-dirs: app
  default-language: GHC2024
